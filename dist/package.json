{
    "name": "n8n-nodes-commercetools",
    "version": "1.0.15",
    "description": "n8n custom node for commercetools — auto-generated from official Postman collection",
    "license": "MIT",
    "homepage": "",
    "keywords": [
        "n8n-community-node-package",
        "commercetools",
        "ecommerce"
    ],
    "author": {
        "name": "Koteswara Rao Mudila",
        "email": "koteswara@compose.co.in"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/jjtech-digital/n8n-nodes-commercetools.git"
    },
    "scripts": {
        "generate": "ts-node scripts/generate.ts",
        "build": "n8n-node build",
        "postbuild": "node scripts/copyLambda.js",
        "build:watch": "tsc --watch",
        "update": "npm run generate && npm run build",
        "dev": "n8n-node dev",
        "test": "echo \"No tests defined\" && exit 0",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "release": "git fetch --tags --prune && n8n-node release",
        "prepublishOnly": "npm run update && n8n-node prerelease",
        "check:changelog": "node -e \"const fs=require('fs');const pkg=require('./package.json');const version='v'+pkg.version;const changelog=fs.readFileSync('CHANGELOG.md','utf8');if(!changelog.includes('#### ['+version+']')){console.error('Changelog missing section for',version);process.exit(1);}const {spawnSync}=require('child_process');const result=spawnSync('git',['tag',version],{stdio:'ignore'});if(result.status!==0){console.error('Git tag missing for',version);process.exit(result.status||1);}\""
    },
    "files": [
        "dist",
        "package.json"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": false,
        "credentials": [
            "dist/credentials/CommerceToolsOAuth2Api.credentials.js"
        ],
        "nodes": [
            "dist/nodes/Commercetools/Commercetools.node.js",
            "dist/nodes/Commercetools/CommercetoolsTrigger.node.js"
        ]
    },
    "dependencies": {
        "@aws-sdk/client-cloudwatch-logs": "^3.0.0",
        "@aws-sdk/client-iam": "^3.0.0",
        "@aws-sdk/client-lambda": "^3.0.0",
        "@aws-sdk/client-sqs": "^3.0.0",
        "@aws-sdk/client-sts": "^3.0.0",
        "@commercetools/platform-sdk": "^8.25.0",
        "@google-cloud/pubsub": "^5.3.0",
        "@google-cloud/storage": "^7.19.0",
        "adm-zip": "^0.5.16",
        "googleapis": "^171.4.0"
    },
    "devDependencies": {
        "@n8n/node-cli": "^0.17.0",
        "@types/adm-zip": "^0.5.8",
        "@types/node": "^25.6.0",
        "auto-changelog": "^2.5.0",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "n8n-workflow": "^2.13.1",
        "prettier": "3.6.2",
        "release-it": "^19.2.4",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    },
    "overrides": {
        "handlebars": "^4.7.9"
    }
}
